Screen {
    background: ansi_default;
    color: ansi_default;
}

/* the arrows' padding stands in for the margin, so the glyph sits where the
   date used to start */
#date-line {
    height: 1;
}

#date-line > * {
    width: auto;
}

.link {
    padding: 0 1;
}

.link:hover {
    background: ansi_black;
}

#hidden {
    margin-left: 1;
}

#body {
    height: 1fr;
    margin: 0 1;
}

#task-pane {
    width: 74;
    max-width: 65%;
}

#columns {
    height: auto;
    /* option padding plus the scrollbar gutter, so headers sit over their values */
    padding: 0 2 0 1;
}

/* the space under the column names, which the list may fill but not exceed */
#list-area {
    height: 1fr;
}

VimList {
    height: auto;
    max-height: 100%;
    border: none;
    background: ansi_default;
    padding: 0;
    /* titles truncate, so a list never scrolls sideways */
    scrollbar-size: 0 1;
    scrollbar-gutter: stable;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

VimList:focus {
    border: none;
}

VimList > .option-list--option {
    padding: 0 1;
}

VimList > .option-list--option-highlighted {
    background: ansi_black;
    color: ansi_default;
    text-style: none;
}

VimList:focus > .option-list--option-highlighted {
    text-style: bold;
}

/* subtotal rows: shown at full strength, only the cursor skips them */
VimList > .option-list--option-disabled {
    color: ansi_default;
}

VimList > .option-list--option-hover {
    background: ansi_black;
}

#empty {
    height: auto;
    padding: 1 1 0 1;
    color: ansi_blue;
}

#stats {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 1;
    border-left: solid ansi_black;
}

/* as wide as its rows, so the hover ends where the values do */
#schedule {
    width: auto;
    height: auto;
}

#schedule:hover {
    background: ansi_black;
}

#totals {
    height: auto;
    margin-top: 1;
}

Footer {
    background: ansi_default;
}

FooterKey > .footer-key--key {
    color: ansi_blue;
    background: ansi_default;
}

FooterKey > .footer-key--description {
    color: ansi_default;
    background: ansi_default;
}

ModalScreen {
    align: center middle;
    background: ansi_default;
}

.dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round ansi_blue;
    padding: 1 2;
    background: ansi_default;
    scrollbar-size: 1 1;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

/* one-row fields on a dark background, so they show without a border */
.dialog Input, .dialog Input:focus {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

.dialog Input:focus {
    text-style: bold;
}

.muted {
    color: ansi_default;
    text-style: dim;
}

/* message lines appear only with a message, each set off by a blank row */
#error, #added {
    display: none;
    height: auto;
    margin-top: 1;
}

#error {
    color: ansi_red;
}

.bottom-row {
    height: auto;
    margin-top: 1;
}

#hint {
    width: 1fr;
}

.button {
    width: auto;
    margin-left: 2;
    padding: 0 1;
    background: ansi_black;
}

.button:hover {
    text-style: bold;
}

/* a context menu over the list, which stays visible around it */
RowMenu {
    align: left top;
    background: transparent;
}

#row-menu, #row-menu:focus {
    border: round ansi_blue;
    scrollbar-gutter: auto;
}

Toast {
    width: auto;
    max-width: 90%;
    margin-top: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sort-dialog {
    width: 40;
}

#task-dialog {
    width: 80;
}

#task-fields {
    height: 1;
}

#task-fields Label {
    width: auto;
    margin: 0 1 0 0;
    text-style: dim;
}

#task-fields Input {
    margin-right: 2;
}

#available {
    width: 7;
}

/* room for 23h59m and the cursor */
#minutes {
    width: 9;
}

#task-fields #title {
    width: 1fr;
    margin-right: 0;
}

#schedule-dialog {
    width: 50;
}

/* the time format reads as the title's second line */
#schedule-dialog .dialog-title {
    margin-bottom: 0;
}

#time-format {
    margin-bottom: 1;
}

/* outside the scrolled keys, so close stays in view */
#help-dialog .bottom-row {
    dock: bottom;
}

#intervals {
    height: auto;
}

/* a blank row between intervals, so their fields don't merge into a block;
   the add and remove lines take the place of the next row */
.interval {
    height: 1;
    margin-bottom: 1;
}

/* room for 23:59 and the cursor */
.interval Input, .interval Input:focus {
    width: 8;
}

.interval Label {
    width: 3;
    content-align: center middle;
}

.interval .note {
    width: 1fr;
    text-align: right;
}

#row-actions {
    height: 1;
}

/* padded like the fields, so their text starts at the times' first digit */
.row-action {
    width: auto;
    margin-right: 2;
    padding: 0 1;
    text-style: dim;
}

.row-action:hover, .row-action:focus {
    background: ansi_black;
    text-style: bold;
}
