Screen {
    background: ansi_default;
    color: ansi_default;
}

#day-bar {
    height: 2;
    margin: 1 1 0 1;
    border-bottom: solid ansi_black;
}

#day-bar Button {
    min-width: 0;
    width: auto;
    color: ansi_default;
    background: ansi_default;
}

#day-bar #choose-day {
    width: 1fr;
    text-align: left;
    text-style: bold underline;
    color: ansi_magenta;
}

#day-bar Button:hover,
#day-bar Button:focus {
    background: ansi_black;
    color: ansi_blue;
    text-style: bold;
}

#day-bar #today {
    background: ansi_default;
    color: ansi_blue;
    text-style: bold;
}

#day-bar #today:hover,
#day-bar #today:focus {
    background: ansi_black;
    text-style: bold;
}

#day-bar #toggle-view {
    display: none;
}

#body {
    height: 1fr;
    margin: 0 1;
}

#task-pane {
    width: 1fr;
}

#columns {
    height: 1;
    padding: 0 1;
    margin-right: 1;
    text-style: dim;
}

#tasks {
    height: 1fr;
    border: none;
    background: ansi_default;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_blue;
}

#tasks:focus {
    border: none;
}

#tasks > .option-list--option {
    padding: 0 1;
}

#tasks > .option-list--option-highlighted {
    background: ansi_black;
    color: ansi_default;
    text-style: none;
}

#tasks:focus > .option-list--option-highlighted {
    text-style: bold;
}

#tasks > .option-list--option-hover {
    background: ansi_black;
    text-style: underline;
}

#tasks > .option-list--option-disabled {
    color: ansi_magenta;
    text-style: bold;
    opacity: 100%;
    padding: 0 1;
}

#empty {
    height: auto;
    padding: 1;
    color: ansi_blue;
}

#sidebar {
    width: 32;
    margin-left: 1;
    padding-left: 1;
    border-left: solid ansi_black;
    scrollbar-size: 1 1;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_blue;
}

#sidebar:focus-within {
    border-left: solid ansi_blue;
}

#sidebar Static {
    height: auto;
    margin-bottom: 1;
}

#sidebar #difference {
    margin-bottom: 0;
}

.pane-action {
    min-width: 0;
    width: auto;
    color: ansi_blue;
    background: ansi_default;
    text-style: bold underline;
    margin-bottom: 0;
}

Footer {
    background: ansi_default;
}

FooterKey > .footer-key--key {
    color: ansi_blue;
    background: ansi_default;
}

FooterKey > .footer-key--description {
    color: ansi_default;
    background: ansi_default;
}

Screen.compact #day-bar #toggle-view {
    display: block;
}

Screen.compact #task-pane {
    width: 100%;
}

Screen.compact #sidebar {
    display: none;
}

Screen.compact.analytics #task-pane {
    display: none;
}

Screen.compact.analytics #sidebar {
    display: block;
    width: 100%;
    height: 1fr;
    margin: 0;
    padding: 0;
    border-left: none;
}

Screen.narrow #day-bar {
    layout: grid;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 2fr;
    grid-rows: 1 1;
    height: 3;
}

Screen.narrow #day-bar #choose-day {
    column-span: 4;
    width: 100%;
}

Screen.narrow #day-bar Button {
    width: 100%;
}

ModalScreen {
    align: center middle;
    background: ansi_default;
}

.dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round ansi_blue;
    padding: 1 2;
    background: ansi_default;
}

.dialog-title {
    text-style: bold;
    color: ansi_magenta;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
}

.dialog Input, .dialog Select {
    width: 1fr;
}

.dialog Input {
    background: ansi_default;
    border: tall ansi_black;
}

.dialog Input:focus {
    border: tall ansi_blue;
}

.dialog Button {
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

.dialog Button.-primary {
    background: ansi_blue;
    color: ansi_black;
    text-style: bold;
}

.dialog Button.-error {
    background: ansi_red;
    color: ansi_black;
}

.dialog Button:focus,
.dialog Button:hover {
    text-style: bold underline;
}

.fields {
    height: 5;
}

.fields Vertical {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

DialogButtons {
    height: 1;
    align-horizontal: right;
    margin-top: 1;
}

DialogButtons Button {
    margin-left: 1;
}

.muted {
    color: ansi_default;
    text-style: dim;
}

#error {
    height: auto;
    color: ansi_red;
}

#schedule-dialog {
    width: 78;
}

#interval-rows {
    height: auto;
    margin-top: 1;
}

.interval-row {
    height: 5;
    margin-bottom: 1;
}

.interval-clock {
    width: 1fr;
    min-width: 8;
    height: 5;
    margin-right: 1;
}

.interval-row Checkbox {
    width: auto;
    margin-top: 1;
}

.interval-row Button {
    width: auto;
    min-width: 0;
    text-wrap: nowrap;
    margin: 1 0 0 1;
}

ScheduleEditor.narrow .interval-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 5 3;
    height: 8;
}

ScheduleEditor.narrow .interval-row Checkbox,
ScheduleEditor.narrow .interval-row Button {
    margin-top: 0;
}

Toast {
    width: auto;
    max-width: 90%;
    margin-top: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
