Screen {
    background: ansi_default;
    color: ansi_default;
}

/* no left margin: the arrows' padding is the line's left edge. The right padding
   ends the mode switch at the task list's right edge */
#date-line {
    height: 1;
    padding-right: 2;
}

#date-line > * {
    width: auto;
}

.link {
    padding: 0 1;
}

.link:hover {
    background: ansi_black;
}

#hidden {
    margin-left: 1;
}

#date-gap {
    width: 1fr;
}

#days-mode, #lists-mode {
    padding: 0 1;
    text-style: dim;
}

#days-mode.mode-on, #lists-mode.mode-on {
    text-style: bold;
}

#days-mode:hover, #lists-mode:hover {
    background: ansi_black;
}

#mode-dot {
    text-style: dim;
}

/* padded like the column names, to share the task list's edges */
#summary {
    height: auto;
    margin: 1 1 0 1;
    padding: 0 2 0 1;
}

#task-pane {
    height: 1fr;
    margin: 0 1;
}

#columns {
    height: auto;
    /* option padding plus the scrollbar gutter, to align the names with the values */
    padding: 0 2 0 1;
}

/* the list may fill this but not grow past it */
#list-area {
    height: 1fr;
}

VimList {
    height: auto;
    max-height: 100%;
    border: none;
    background: ansi_default;
    padding: 0;
    /* no horizontal scrollbar; titles truncate instead */
    scrollbar-size: 0 1;
    scrollbar-gutter: stable;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

VimList:focus {
    border: none;
}

VimList > .option-list--option {
    padding: 0 1;
}

VimList > .option-list--option-highlighted {
    background: ansi_black;
    color: ansi_default;
    text-style: none;
}

VimList:focus > .option-list--option-highlighted {
    text-style: bold;
}

/* subtotal rows are disabled options, styled like enabled ones */
VimList > .option-list--option-disabled {
    color: ansi_default;
}

VimList > .option-list--option-hover {
    background: ansi_black;
}

#empty {
    height: auto;
    padding: 1 1 0 1;
    color: ansi_blue;
}

/* auto width keeps the hover background inside the values */
#schedule {
    width: auto;
    height: auto;
}

#schedule:hover {
    background: ansi_black;
}

#totals {
    height: auto;
}

Footer {
    background: ansi_default;
}

FooterKey > .footer-key--key {
    color: ansi_blue;
    background: ansi_default;
}

FooterKey > .footer-key--description {
    color: ansi_default;
    background: ansi_default;
}

ModalScreen {
    align: center middle;
    background: ansi_default;
}

.dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round ansi_blue;
    padding: 1 2;
    background: ansi_default;
    scrollbar-size: 1 1;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

.dialog Input, .dialog Input:focus {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

.dialog Input:focus {
    text-style: bold;
}

.muted {
    color: ansi_default;
    text-style: dim;
}

#error, #added {
    display: none;
    height: auto;
    margin-top: 1;
}

#error {
    color: ansi_red;
}

.bottom-row {
    height: auto;
    margin-top: 1;
}

#hint {
    width: 1fr;
}

.button {
    width: auto;
    margin-left: 2;
    padding: 0 1;
    background: ansi_black;
}

.button:hover {
    text-style: bold;
}

/* transparent, to keep the list visible around the menu */
RowMenu {
    align: left top;
    background: transparent;
}

#row-menu, #row-menu:focus {
    border: round ansi_blue;
    scrollbar-gutter: auto;
}

Toast {
    width: auto;
    max-width: 90%;
    margin-top: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sort-dialog {
    width: 40;
}

#task-dialog {
    width: 80;
}

#task-fields {
    height: 1;
}

#task-fields Label {
    width: auto;
    margin: 0 1 0 0;
    text-style: dim;
}

#task-fields Input {
    margin-right: 2;
}

/* two classes, to outrank .dialog Input */
.dialog .points-field, .dialog .points-field:focus {
    width: 7;
}

/* room for 23h59m and the cursor */
#minutes {
    width: 9;
}

#task-fields #title {
    width: 1fr;
    margin-right: 0;
}

#schedule-dialog {
    width: 50;
}

#picker-dialog {
    width: 80;
}

#no-lists {
    height: auto;
}

#span-dialog {
    width: 62;
}

.span-row {
    height: 1;
    margin-bottom: 1;
}

.span-row Label {
    width: 5;
    margin-right: 1;
    text-style: dim;
}

.span-row #to-label {
    width: auto;
    margin: 0 1 0 1;
}

.span-row Input, .span-row Input:focus {
    margin-right: 1;
}

#span-title, #span-title:focus {
    width: 1fr;
    margin-right: 0;
}

/* room for 2026-11-20 and the cursor; two classes, to outrank .dialog Input */
.dialog .date-field, .dialog .date-field:focus {
    width: 13;
}

/* room for 23:59 and the cursor */
.span-row .time-field, .span-row .time-field:focus {
    width: 8;
}

#schedule-dialog .dialog-title {
    margin-bottom: 0;
}

#time-format {
    margin-bottom: 1;
}

/* docked, to keep close visible while the keys scroll */
#help-dialog .bottom-row {
    dock: bottom;
}

#intervals {
    height: auto;
}

.interval {
    height: 1;
    margin-bottom: 1;
}

/* room for 23:59 and the cursor */
.interval Input, .interval Input:focus {
    width: 8;
}

.interval Label {
    width: 3;
    content-align: center middle;
}

.interval .note {
    width: 1fr;
    text-align: right;
}

#row-actions {
    height: 1;
}

/* padded like the fields, to align with the times' first digit */
.row-action {
    width: auto;
    margin-right: 2;
    padding: 0 1;
    text-style: dim;
}

.row-action:hover, .row-action:focus {
    background: ansi_black;
    text-style: bold;
}
