Screen {
    background: ansi_default;
    color: ansi_default;
}

#date {
    height: 1;
    margin: 0 1;
}

#body {
    height: 1fr;
    margin: 0 1;
}

#task-pane {
    width: 74;
    max-width: 65%;
}

#columns {
    height: 1;
    /* option padding plus the scrollbar gutter, so headers sit over their values */
    padding: 0 2 0 1;
    text-style: dim;
}

#tasks {
    height: auto;
    max-height: 100%;
    border: none;
    background: ansi_default;
    padding: 0;
    scrollbar-size: 1 1;
    scrollbar-gutter: stable;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

#tasks:focus {
    border: none;
}

#tasks > .option-list--option {
    padding: 0 1;
}

#tasks > .option-list--option-highlighted {
    background: ansi_black;
    color: ansi_default;
    text-style: none;
}

#tasks:focus > .option-list--option-highlighted {
    text-style: bold;
}

#tasks > .option-list--option-hover {
    background: ansi_black;
}

#empty {
    height: auto;
    padding: 1 1 0 1;
    color: ansi_blue;
}

#stats {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 2;
    border-left: solid ansi_black;
}

Footer {
    background: ansi_default;
}

FooterKey > .footer-key--key {
    color: ansi_blue;
    background: ansi_default;
}

FooterKey > .footer-key--description {
    color: ansi_default;
    background: ansi_default;
}

ModalScreen {
    align: center middle;
    background: ansi_default;
}

.dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round ansi_blue;
    padding: 1 2;
    background: ansi_default;
}

.dialog-title {
    text-style: bold;
    color: ansi_magenta;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
}

.dialog Input, .dialog Select {
    width: 1fr;
}

.dialog Input {
    background: ansi_default;
    border: tall ansi_black;
}

.dialog Input:focus {
    border: tall ansi_blue;
}

.dialog Button {
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

.dialog Button.-primary {
    background: ansi_blue;
    color: ansi_black;
    text-style: bold;
}

.dialog Button:focus,
.dialog Button:hover {
    text-style: bold underline;
}

DialogButtons {
    height: 1;
    align-horizontal: right;
    margin-top: 1;
}

DialogButtons Button {
    margin-left: 1;
}

.muted {
    color: ansi_default;
    text-style: dim;
}

#error {
    height: auto;
    color: ansi_red;
}

#schedule-dialog {
    width: 78;
}

#interval-rows {
    height: auto;
    margin-top: 1;
}

.interval-row {
    height: 5;
    margin-bottom: 1;
}

.interval-clock {
    width: 1fr;
    min-width: 8;
    height: 5;
    margin-right: 1;
}

.interval-row Checkbox {
    width: auto;
    margin-top: 1;
}

.interval-row Button {
    width: auto;
    min-width: 0;
    text-wrap: nowrap;
    margin: 1 0 0 1;
}

ScheduleEditor.narrow .interval-row {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 5 3;
    height: 8;
}

ScheduleEditor.narrow .interval-row Checkbox,
ScheduleEditor.narrow .interval-row Button {
    margin-top: 0;
}

Toast {
    width: auto;
    max-width: 90%;
    margin-top: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#task-dialog {
    width: 80;
}

#task-fields {
    height: 1;
}

/* one-row fields; the bordered .dialog Input style would leave no room for text */
#task-fields Input, #section-dialog Input,
#task-fields Input:focus, #section-dialog Input:focus {
    border: none;
    height: 1;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

#task-fields Input:focus, #section-dialog Input:focus {
    text-style: bold;
}

#task-fields Label {
    width: auto;
    margin: 0 1 0 0;
    text-style: dim;
}

#task-fields Input {
    margin-right: 2;
}

#available, #minutes {
    width: 7;
}

#task-fields #title {
    width: 1fr;
    margin-right: 0;
}

.dialog {
    scrollbar-size: 1 1;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

/* an unchecked box shows no X, so the state doesn't rest on colour alone */
Checkbox > .toggle--button {
    color: ansi_black;
    background: ansi_black;
}

Checkbox.-on > .toggle--button {
    color: ansi_green;
    text-style: bold;
}
