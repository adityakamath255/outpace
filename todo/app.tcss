Screen {
    background: ansi_default;
    color: ansi_default;
}

#date {
    height: 1;
    margin: 0 1;
}

#body {
    height: 1fr;
    margin: 0 1;
}

#task-pane {
    width: 74;
    max-width: 65%;
}

#columns {
    height: auto;
    /* option padding plus the scrollbar gutter, so headers sit over their values */
    padding: 0 2 0 1;
}

/* the space under the column names, which the list may fill but not exceed */
#list-area {
    height: 1fr;
}

VimList {
    height: auto;
    max-height: 100%;
    border: none;
    background: ansi_default;
    padding: 0;
    /* titles truncate, so a list never scrolls sideways */
    scrollbar-size: 0 1;
    scrollbar-gutter: stable;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

VimList:focus {
    border: none;
}

VimList > .option-list--option {
    padding: 0 1;
}

VimList > .option-list--option-highlighted {
    background: ansi_black;
    color: ansi_default;
    text-style: none;
}

VimList:focus > .option-list--option-highlighted {
    text-style: bold;
}

/* subtotal rows: shown at full strength, only the cursor skips them */
VimList > .option-list--option-disabled {
    color: ansi_default;
}

VimList > .option-list--option-hover {
    background: ansi_black;
}

#empty {
    height: auto;
    padding: 1 1 0 1;
    color: ansi_blue;
}

#stats {
    width: 1fr;
    height: 100%;
    margin-left: 1;
    padding-left: 2;
    border-left: solid ansi_black;
}

Footer {
    background: ansi_default;
}

FooterKey > .footer-key--key {
    color: ansi_blue;
    background: ansi_default;
}

FooterKey > .footer-key--description {
    color: ansi_default;
    background: ansi_default;
}

ModalScreen {
    align: center middle;
    background: ansi_default;
}

.dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    border: round ansi_blue;
    padding: 1 2;
    background: ansi_default;
    scrollbar-size: 1 1;
    scrollbar-background: ansi_default;
    scrollbar-color: ansi_black;
}

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

/* one-row fields on a dark background, so they show without a border */
.dialog Input, .dialog Input:focus {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: ansi_black;
    color: ansi_default;
}

.dialog Input:focus {
    text-style: bold;
}

.muted {
    color: ansi_default;
    text-style: dim;
}

/* message lines appear only with a message, each set off by a blank row */
#error, #added {
    display: none;
    height: auto;
    margin-top: 1;
}

#error {
    color: ansi_red;
}

.hint {
    margin-top: 1;
}

Toast {
    width: auto;
    max-width: 90%;
    margin-top: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#sort-dialog {
    width: 40;
}

#task-dialog {
    width: 80;
}

#task-fields {
    height: 1;
}

#task-fields Label {
    width: auto;
    margin: 0 1 0 0;
    text-style: dim;
}

#task-fields Input {
    margin-right: 2;
}

#available {
    width: 7;
}

/* room for 23h59m and the cursor */
#minutes {
    width: 9;
}

#task-fields #title {
    width: 1fr;
    margin-right: 0;
}
